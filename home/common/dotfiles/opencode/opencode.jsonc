{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "model": "openai/gpt-5.6-sol",
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "sisyphus",
  "plugin": [
    "oh-my-openagent@4.19.4",
    "opencode-skill-creator"
  ],
  "lsp": {},
  "mcp": {
    "miloa": {
      "type": "remote",
      "url": "https://miloa-beta.comni.pl/w/69f1f3e11d1ab359d844ba89/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "godot": {
      "type": "local",
      "command": ["npx", "@coding-solo/godot-mcp"],
      "enabled": true,
      "timeout": 30000
      // GODOT_PATH is intentionally omitted — godot-mcp auto-detects.
      // Platform reference:
      //   Darwin: /opt/homebrew/bin/godot (Homebrew cask)
      //   NixOS Desktop: godot in PATH via pkgsUnstable.godot_4_6
      //   WSL: Godot not installed; disable if needed
    }
  }
}
