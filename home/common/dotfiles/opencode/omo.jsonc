{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [429, 500, 502, 503, 504],
      "max_fallback_attempts": 2,
      "cooldown_seconds": 20,
      // Avoid aborting an active fallback just to escalate to the next model.
      "timeout_seconds": 0,
      "notify_on_fallback": true
    },
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.4",
        "reasoning": "high"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "librarian": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": [
          {
            "model": "openai/gpt-5.4",
            "reasoning": "medium"
          }
        ]
      },
      "explore": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": [
          {
            "model": "openai/gpt-5.4",
            "reasoning": "medium"
          }
        ]
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.4",
        "reasoning": "medium"
      },
      "prometheus": {
        "model": "openai/gpt-5.5",
        "reasoning": "medium"
      },
      "metis": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "momus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      },
      "atlas": {
        "model": "openai/gpt-5.4",
        "reasoning": "medium"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.4",
        "reasoning": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      },
      "deep": {
        "model": "openai/gpt-5.4",
        "reasoning": "medium"
      },
      "artistry": {
        "model": "openai/gpt-5.4",
        "reasoning": "medium"
      },
      "quick": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": [
          {
            "model": "openai/gpt-5.4",
            "reasoning": "medium"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.4-mini"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.4",
        "reasoning": "high"
      },
      "writing": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": [
          {
            "model": "openai/gpt-5.4",
            "reasoning": "medium"
          }
        ]
      }
    },
    "skills": {
      "programming": false,
      "executable-specification": true
    },
    "git_master": {
      "include_co_authored_by": false
    }
  },
  "profiles": {
    "proportional": {},
    "strict": {
      "[opencode]": {
        "skills": {
          "programming": true,
          "executable-specification": false
        }
      }
    }
  }
}
