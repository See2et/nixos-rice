// Models and review routing are calibrated for this exact OmO release.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v5.0.0-beta.51/assets/omo.schema.json",
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 2,
      "cooldown_seconds": 20,
      "timeout_seconds": 0,
      "notify_on_fallback": true
    },
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "prompt_append": "Local workflow calibration: follow AGENTS.md. Procedural step count alone does not trigger Plan or implementation delegation. Self-plan clear work; delegate bounded independent outcomes. Use prometheus only for an explicit planning request and metis for a consequential unresolved question. Design-related implementation belongs to Astra throughout implementation and browser iteration. Required independent reviews remain separate."
      },
      "hephaestus": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high",
        "prompt_append": "Local workflow calibration: use the AGENTS.md routing and acceptance rules. There is no minimum exploration-agent count: the default 2-5 suggestion applies only when there are that many useful independent questions. Keep clear, coupled work with the primary; delegate bounded independent work and retain its owner through implementation and routine checks. Design-related implementation stays with Astra, including browser iteration. A primary already using Astra may implement the UI directly. Required independent reviews remain separate. Do not silently change the design owner to a lower model.",
        "fallback_models": []
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high",
        "prompt_append": "For review requests, follow the submitted review contract: accepted goal and constraints, diff, QA evidence, and blocker ledger. Block only on an unmet acceptance condition or concrete material regression with an affected location, realistic trigger or direct evidence, and minimum correction. Optional style, alternative architecture, and speculative hardening are notes. Missing required evidence is INCONCLUSIVE. After fixes, inspect the accepted blocker IDs and delta with affected checks; reopen closed items only for new concrete evidence or a regression. Do not spawn sub-reviewers or load broad security-research for an ordinary scoped review. Preserve repository and major-change gates. For diagnostic consultations, answer the specific unresolved question rather than starting a full review."
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          }
        ]
      },
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          }
        ]
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "low",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          }
        ]
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "metis": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "momus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "atlas": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
          }
        ]
      }
    },
    // Explicit variants prevent inherited category defaults from overriding per-model effort.
    "categories": {
      "visual-engineering": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "variant": "high"
          }
        ]
      },
      "ultrabrain": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "variant": "high"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "xhigh"
          }
        ]
      },
      "deep": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "variant": "high"
          }
        ]
      },
      "quick": {
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "variant": "low"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          }
        ]
      },
      "unspecified-low": {
        "models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          }
        ]
      },
      "unspecified-high": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "high"
          },
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
          }
        ]
      },
      "writing": {
        "models": [
          {
            "model": "openai/gpt-5.6-terra",
            "variant": "medium"
          },
          {
            "model": "openai/gpt-5.6-luna",
            "variant": "low"
          }
        ]
      }
    },
    "skills": {
      "programming": false,
      "executable-specification": true
    },
    "git_master": {
      "include_co_authored_by": false
    },
    "background_task": {
      "defaultConcurrency": 3,
      "providerConcurrency": {
        "openai": 3
      }
    },
    "default_run_agent": "hephaestus"
  },
  "profiles": {
    "proportional": {},
    "strict": {
      "[opencode]": {
        "skills": {
          "programming": true,
          "executable-specification": false
        }
      }
    }
  }
}
